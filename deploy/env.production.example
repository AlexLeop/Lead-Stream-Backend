# Copie estes nomes para os segredos do EasyPanel. Nunca versione valores reais.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<gere-uma-chave-aleatoria-longa>
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DATABASE_URL=postgresql://<usuario>:<senha>@lead_stream_postgres:5432/<banco>
DATABASE_SSL_REQUIRED=false
DATABASE_CONN_MAX_AGE=60

CELERY_BROKER_URL=amqp://<usuario>:<senha>@lead_stream_rabbitmq:5672/<vhost>
REDIS_URL=redis://lead_stream_redis:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_TIME_LIMIT=600

APPWRITE_ENDPOINT=http://lead_stream_appwrite/v1
APPWRITE_PROJECT_ID=<id-do-projeto>
APPWRITE_API_KEY=<nova-chave-runtime-com-escopo-minimo>
APPWRITE_TIMEOUT_SECONDS=3
APPWRITE_STORAGE_BUCKET_EXPORTS=exports

DATA_HASH_KEY=<gere-uma-chave-hmac-aleatoria-e-independente>
DATA_HASH_KEY_VERSION=v1
DATA_HASH_PREVIOUS_KEYS=

# Motor de processamento e lotes
BATCH_STORAGE_ROOT=./data/batches
BATCH_MAX_UPLOAD_BYTES=52428800
BATCH_MAX_ROWS=100000
BATCH_LEASE_SECONDS=300

# Provedor 1: Google Cloud / BigQuery
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GOOGLE_CREDENTIALS_JSON=
BIGQUERY_PROJECT_ID=<projeto-gcp>
OPEN_CNPJ_BIGQUERY_SQL="WITH est AS (SELECT * FROM `basedosdados.br_me_cnpj.estabelecimentos` WHERE data = '2026-01-11' AND cnpj = @cnpj), emp AS (SELECT * FROM `basedosdados.br_me_cnpj.empresas` WHERE data = '2026-01-11' AND cnpj_basico = SUBSTR(@cnpj, 1, 8)), soc AS (SELECT cnpj_basico, ARRAY_AGG(STRUCT(nome AS nome_socio, qualificacao AS qualificacao_socio, faixa_etaria)) AS socios FROM `basedosdados.br_me_cnpj.socios` WHERE data = '2026-01-11' AND cnpj_basico = SUBSTR(@cnpj, 1, 8) GROUP BY cnpj_basico) SELECT est.cnpj, emp.razao_social, est.nome_fantasia, est.situacao_cadastral, est.cnae_fiscal_principal AS cnae_fiscal, est.sigla_uf AS uf, est.id_municipio AS municipio, est.logradouro, est.numero, est.bairro, est.cep, est.ddd_1, est.telefone_1, est.email, emp.capital_social, emp.porte, emp.natureza_juridica, CASE WHEN ARRAY_LENGTH(COALESCE(soc.socios, [])) > 0 THEN soc.socios WHEN emp.natureza_juridica = '2135' THEN [STRUCT(TRIM(REGEXP_REPLACE(emp.razao_social, r'^[0-9\.\/\- ]+', '')) AS nome_socio, 'PROPRIETARIO' AS qualificacao_socio, CAST(NULL AS STRING) AS faixa_etaria)] ELSE [] END AS socios FROM est LEFT JOIN emp ON est.cnpj_basico = emp.cnpj_basico LEFT JOIN soc ON est.cnpj_basico = soc.cnpj_basico"
OPEN_CNPJ_DISCOVERY_SQL="SELECT est.*, emp.razao_social FROM `basedosdados.br_me_cnpj.estabelecimentos` est LEFT JOIN `basedosdados.br_me_cnpj.empresas` emp ON est.cnpj_basico = emp.cnpj_basico AND emp.data = '2026-01-11' WHERE est.data = '2026-01-11' AND est.sigla_uf IN UNNEST(@ufs) LIMIT @limit OFFSET @offset"
BIGQUERY_MAXIMUM_BYTES_BILLED=50000000000
BIGQUERY_TIMEOUT_SECONDS=60
BIGQUERY_COST_CENTS_PER_TIB=3500
BIGQUERY_COST_CENTS=0
BIGQUERY_PROVIDER_PRIORITY=10
BIGQUERY_CONFIDENCE=100

# Provedor 2: BigDataCorp
BIGDATACORP_BASE_URL=https://plataforma.bigdatacorp.com.br
BIGDATACORP_ACCESS_TOKEN=<token-bigdatacorp>
BIGDATACORP_TOKEN_ID=<token-id-bigdatacorp>
BIGDATACORP_DATASETS=basic_data,relationships
BIGDATACORP_TIMEOUT_SECONDS=30
BIGDATACORP_COST_CENTS=0
BIGDATACORP_PROVIDER_PRIORITY=20
BIGDATACORP_CONFIDENCE=80

# Provedor 3: Apify
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_TOKEN=<token-apify>
APIFY_API_TOKEN=<token-apify>
APIFY_DECISION_MAKER_ACTOR_ID=curious_coder/linkedin-people-search-scraper
APIFY_COST_CENTS=25
APIFY_USD_RATE_CENTS=600
APIFY_TIMEOUT_SECONDS=300
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_SECONDS=10
APIFY_MAX_RESULTS_PER_COMPANY=10
APIFY_DATASET_PAGE_SIZE=100
APIFY_PROVIDER_PRIORITY=30
APIFY_CONFIDENCE=70

# Provedor 4: Open Enrich
OPEN_ENRICH_URL=
OPEN_ENRICH_TOKEN=
OPEN_ENRICH_COST_CENTS=15
OPEN_ENRICH_TIMEOUT_SECONDS=30
OPEN_ENRICH_CONFIDENCE=75
OPEN_ENRICH_PROVIDER_PRIORITY=40

# Provedor 5: Premium Enrich
PREMIUM_ENRICH_URL=
PREMIUM_ENRICH_TOKEN=
PREMIUM_ENRICH_COST_CENTS=50
PREMIUM_ENRICH_TIMEOUT_SECONDS=30
PREMIUM_ENRICH_CONFIDENCE=85
PREMIUM_ENRICH_PROVIDER_PRIORITY=50

# Conectores CRM & Webhooks
CRM_CONNECTOR_DEFAULT_TIMEOUT_SECONDS=10

DEPENDENCY_CHECK_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
