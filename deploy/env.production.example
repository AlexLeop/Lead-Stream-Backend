# Copie estes nomes para os segredos do EasyPanel. Nunca versione valores reais.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<gere-uma-chave-aleatoria-longa>
DJANGO_ALLOWED_HOSTS=<api.seu-dominio.com>
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DATABASE_URL=postgresql://<usuario>:<senha>@<servico-postgres>:5432/<banco>
DATABASE_SSL_REQUIRED=false
DATABASE_CONN_MAX_AGE=60

CELERY_BROKER_URL=amqp://<usuario>:<senha>@<servico-rabbitmq>:5672/<vhost>
REDIS_URL=redis://<servico-redis>:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_TIME_LIMIT=600

APPWRITE_ENDPOINT=https://<appwrite.seu-dominio.com>/v1
APPWRITE_PROJECT_ID=<id-do-projeto>
APPWRITE_API_KEY=<nova-chave-runtime-com-escopo-minimo>
APPWRITE_TIMEOUT_SECONDS=3

DATA_HASH_KEY=<gere-uma-chave-hmac-aleatoria-e-independente>
DATA_HASH_KEY_VERSION=v1
DATA_HASH_PREVIOUS_KEYS=

GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
BIGQUERY_PROJECT_ID=replace-with-project-id
OPEN_CNPJ_BIGQUERY_SQL=
OPEN_CNPJ_DISCOVERY_SQL=
BIGQUERY_MAXIMUM_BYTES_BILLED=10000000000
BIGDATACORP_ACCESS_TOKEN=replace-with-runtime-token
BIGDATACORP_TOKEN_ID=replace-with-token-id
BIGDATACORP_DATASETS=basic_data,relationships
BIGDATACORP_COST_CENTS=0
APIFY_TOKEN=replace-with-runtime-token
APIFY_DECISION_MAKER_ACTOR_ID=replace-with-actor-id
APIFY_COST_CENTS=0
OPEN_ENRICH_URL=
OPEN_ENRICH_TOKEN=
PREMIUM_ENRICH_URL=
PREMIUM_ENRICH_TOKEN=

DEPENDENCY_CHECK_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
