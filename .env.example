# Ambiente local de desenvolvimento. Copie para .env e preencha conforme necessário.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://leadstream:leadstream@postgres:5432/leadstream
DATABASE_SSL_REQUIRED=false
DATABASE_CONN_MAX_AGE=60

# Serviços assíncronos
CELERY_BROKER_URL=amqp://leadstream:leadstream@rabbitmq:5672//
REDIS_URL=redis://redis:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_TIME_LIMIT=600

# Appwrite (opcional no desenvolvimento)
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=replace-with-project-id
APPWRITE_API_KEY=replace-with-runtime-key
APPWRITE_TIMEOUT_SECONDS=3
APPWRITE_STORAGE_BUCKET_EXPORTS=exports

# HMAC de correlação/supressão
DATA_HASH_KEY=dev-only-change-me
DATA_HASH_KEY_VERSION=v1
DATA_HASH_PREVIOUS_KEYS=

# Motor de processamento e lotes
BATCH_STORAGE_ROOT=./data/batches
BATCH_MAX_UPLOAD_BYTES=52428800
BATCH_MAX_ROWS=100000
BATCH_LEASE_SECONDS=300

# Provedor 1: OpenCNPJ / BigQuery
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GOOGLE_CREDENTIALS_JSON=
BIGQUERY_PROJECT_ID=replace-with-project-id
OPEN_CNPJ_BIGQUERY_SQL=SELECT * FROM `basedosdados.br_me_cnpj.estabelecimentos` WHERE cnpj = @cnpj
OPEN_CNPJ_DISCOVERY_SQL=SELECT * FROM `basedosdados.br_me_cnpj.estabelecimentos` WHERE sigla_uf IN UNNEST(@ufs) LIMIT @limit OFFSET @offset
BIGQUERY_MAXIMUM_BYTES_BILLED=10000000000
BIGQUERY_TIMEOUT_SECONDS=60
BIGQUERY_COST_CENTS_PER_TIB=3500
BIGQUERY_COST_CENTS=0
BIGQUERY_PROVIDER_PRIORITY=10
BIGQUERY_CONFIDENCE=100

# Provedor 2: BigDataCorp
BIGDATACORP_BASE_URL=https://plataforma.bigdatacorp.com.br
BIGDATACORP_ACCESS_TOKEN=replace-with-runtime-token
BIGDATACORP_TOKEN_ID=replace-with-token-id
BIGDATACORP_DATASETS=basic_data,relationships
BIGDATACORP_TIMEOUT_SECONDS=30
BIGDATACORP_COST_CENTS=0
BIGDATACORP_PROVIDER_PRIORITY=20
BIGDATACORP_CONFIDENCE=80

# Provedor 3: Apify
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_TOKEN=replace-with-runtime-token
APIFY_API_TOKEN=replace-with-runtime-token
APIFY_DECISION_MAKER_ACTOR_ID=replace-with-actor-id
APIFY_COST_CENTS=25
APIFY_USD_RATE_CENTS=600
APIFY_TIMEOUT_SECONDS=300
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_SECONDS=10
APIFY_MAX_RESULTS_PER_COMPANY=10
APIFY_DATASET_PAGE_SIZE=100
APIFY_PROVIDER_PRIORITY=30
APIFY_CONFIDENCE=70

# Provedor 4: Open Enrich
OPEN_ENRICH_URL=
OPEN_ENRICH_TOKEN=
OPEN_ENRICH_COST_CENTS=15
OPEN_ENRICH_TIMEOUT_SECONDS=30
OPEN_ENRICH_CONFIDENCE=75
OPEN_ENRICH_PROVIDER_PRIORITY=40

# Provedor 5: Premium Enrich
PREMIUM_ENRICH_URL=
PREMIUM_ENRICH_TOKEN=
PREMIUM_ENRICH_COST_CENTS=50
PREMIUM_ENRICH_TIMEOUT_SECONDS=30
PREMIUM_ENRICH_CONFIDENCE=85
PREMIUM_ENRICH_PROVIDER_PRIORITY=50

# Conectores CRM & Webhooks
CRM_CONNECTOR_DEFAULT_TIMEOUT_SECONDS=10

# Observabilidade
DEPENDENCY_CHECK_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
