# Ambiente local. Copie para .env e altere somente fora do Git.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://leadstream:leadstream@postgres:5432/leadstream

# Serviços assíncronos
CELERY_BROKER_URL=amqp://leadstream:leadstream@rabbitmq:5672//
REDIS_URL=redis://redis:6379/0

# Appwrite (opcional no desenvolvimento)
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=replace-with-project-id
APPWRITE_API_KEY=replace-with-runtime-key
APPWRITE_TIMEOUT_SECONDS=3

# HMAC de correlação/supressão. Use valor aleatório diferente do DJANGO_SECRET_KEY.
DATA_HASH_KEY=dev-only-change-me
DATA_HASH_KEY_VERSION=v1
DATA_HASH_PREVIOUS_KEYS=

# OpenCNPJ seletivo no BigQuery. GOOGLE_APPLICATION_CREDENTIALS aponta para arquivo montado.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
BIGQUERY_PROJECT_ID=replace-with-project-id
OPEN_CNPJ_BIGQUERY_SQL=
OPEN_CNPJ_DISCOVERY_SQL=
BIGQUERY_MAXIMUM_BYTES_BILLED=10000000000

# Provedores de enriquecimento (segredos somente no ambiente do EasyPanel)
BIGDATACORP_ACCESS_TOKEN=replace-with-runtime-token
BIGDATACORP_TOKEN_ID=replace-with-token-id
BIGDATACORP_DATASETS=basic_data,relationships
BIGDATACORP_COST_CENTS=0
APIFY_TOKEN=replace-with-runtime-token
APIFY_DECISION_MAKER_ACTOR_ID=replace-with-actor-id
APIFY_COST_CENTS=0
OPEN_ENRICH_URL=
OPEN_ENRICH_TOKEN=
PREMIUM_ENRICH_URL=
PREMIUM_ENRICH_TOKEN=

# Observabilidade
LOG_LEVEL=INFO
